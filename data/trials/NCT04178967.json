    "visit_schedule": {
      "value": "16-week induction treatment period followed by a 36-week long-term maintenance treatment period (52 weeks total treatment). Primary endpoint (IGA 0/1 with >=2-pt reduction, and EASI-75) assessed at Week 16; responders re-randomized at Week 16 to lebrikizumab Q2W, Q4W, or placebo for maintenance, with maintenance-response checks at Weeks 24, 32, 40, 48. Not a full per-visit assessment table -- exact interim visit weeks are not itemized in this source.",
      "source_type": "publication_extraction",
      "source_url": "https://www.accessdata.fda.gov/drugsatfda_docs/nda/2024/761306Orig1s000MultidisciplineR.pdf",
      "source_excerpt": "Section 8 \"Review of Relevant Individual Trials... Studies KGAB (ADvocate 1), KGAC (ADvocate 2), and KGAD (ADhere)\", \"Trial Design\" (KGAC / ADvocate 2)",
      "extracted_by": "manual publication_extraction pass (FDA approval-package review, v1 addendum follow-up; pending human QA)",
      "reviewed_by": null,
      "confidence": 0.65
    },
    "rescue_therapy_rules": {
      "value": "Induction Period: use of topical/systemic AD treatment is prohibited from Baseline through Week 16. If systemic rescue treatment (e.g., oral corticosteroids, phototherapy, cyclosporin) is required, study drug must be discontinued; the patient continues study visits through Week 16. Patients needing systemic rescue must wait for rescue-medication washout (>=5 half-lives) before entering the Escape Arm. Maintenance Period: intermittent topical rescue is permitted; short-term systemic rescue is assessed case-by-case with the medical monitor.",
      "source_type": "protocol_pdf_extraction",
      "source_url": "https://cdn.clinicaltrials.gov/large-docs/67/NCT04178967/Prot_000.pdf",
